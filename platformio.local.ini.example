; Copy to platformio.local.ini (which git ignores) and fill in the device's
; address and the OTA password — the one in src/config/secrets.h.

[env:esp32dev]
upload_protocol = espota
upload_port = 192.168.1.100
upload_flags =
	--auth=change-me
; USB recovery: comment out the lines above and use these instead.
;upload_protocol = esptool
;upload_port = COM3
