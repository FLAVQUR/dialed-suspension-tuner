# PlatformIO build output and downloaded libraries
.pio/

# VS Code files the PlatformIO extension regenerates, with this machine's paths
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Secrets and machine-specific settings — see the *.example files next to them
src/config/secrets.h
platformio.local.ini

# Written by tools/version_stamp.py on every build
include/version_stamp.h

# Local copies kept before a big change, for going back by hand (git has the history)
backups/

# Claude Code per-machine settings
.claude/settings.local.json

# OS, editor and Python leftovers
Thumbs.db
desktop.ini
.DS_Store
*.swp
__pycache__/
*.pyc
